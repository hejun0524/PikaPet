{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for the pet windows",
  "windows": ["main", "setup"],
  "webviews": ["hub", "stats"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-set-position",
    "core:window:allow-current-monitor",
    "core:window:allow-outer-position",
    "core:window:allow-outer-size",
    "core:window:allow-set-size",
    "core:window:allow-hide",
    "core:window:allow-show",
    "core:window:allow-is-visible",
    "core:window:allow-set-visible-on-all-workspaces",
    "core:window:allow-set-title",
    "core:menu:allow-new",
    "core:menu:allow-popup",
    "autostart:allow-enable",
    "autostart:allow-disable",
    "autostart:allow-is-enabled",
    "dialog:allow-open",
    "allow-quit",
    "allow-set-pet-hitbox",
    "allow-show-window",
    "allow-finish-setup",
    "allow-reset-app",
    "allow-load-state",
    "allow-save-state",
    "allow-get-data-paths",
    "allow-open-data-folder",
    "allow-change-data-dir",
    "allow-import-custom-pet",
    "allow-delete-custom-pet",
    "allow-list-music",
    "allow-install-extension",
    "allow-install-extension-from-registry",
    "allow-uninstall-extension",
    "allow-list-installed-extensions",
    "allow-notify",
    "allow-open-extension-window",
    "allow-set-keep-awake",
    "allow-keep-awake-status",
    "allow-log",
    "allow-update-status",
    "allow-restart-to-update"
  ]
}
