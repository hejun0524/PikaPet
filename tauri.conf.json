{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MyPet",
  "version": "0.1.0",
  "identifier": "com.junhe.mypet",
  "build": {
    "frontendDist": "src/ui"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": ["$HOME/**"]
      }
    },
    "windows": [
      {
        "label": "main",
        "title": "MyPet",
        "backgroundThrottling": "disabled",
        "visible": false,
        "width": 220,
        "height": 240,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "maximizable": false,
        "shadow": false,
        "acceptFirstMouse": true
      },
      {
        "label": "stats",
        "title": "Huanhuan",
        "url": "stats.html",
        "backgroundThrottling": "disabled",
        "width": 360,
        "height": 525,
        "visible": false,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "maximizable": false,
        "shadow": true,
        "acceptFirstMouse": true
      },
      {
        "label": "setup",
        "title": "Welcome!",
        "url": "setup.html",
        "width": 640,
        "height": 480,
        "visible": false,
        "center": true,
        "decorations": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": false
      },
      {
        "label": "hub",
        "title": "Pet World",
        "url": "hub.html",
        "backgroundThrottling": "disabled",
        "width": 1240,
        "height": 640,
        "visible": false,
        "center": true,
        "decorations": true,
        "skipTaskbar": true,
        "resizable": true,
        "minWidth": 820,
        "minHeight": 500,
        "maximizable": true,
        "minimizable": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/hejun0524/PikaPet/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMxMzAwQzgyRUIwNDA3QjQKUldTMEJ3VHJnZ3d3d2NyeS9GaFFMMkloV1UrWVFzOE03R1Via09KWUg1aEM5bEN6WDBROGNjOW8K"
    }
  }
}
